<Project>

  <!--
    Keeps the packed XML documentation to the surface a consumer can reach, by running
    tools/filter_public_docs.cs over the compiler's output while it is still in obj. That
    file carries the reasoning; this one is the wiring.

    An out-of-process tool rather than an inline task: the filter has to read visibility out
    of the compiled assembly, and doing that inside MSBuild meant a package reference on the
    library, which in turn meant entries in the published SBOM for something no consumer
    consumes. The tool takes no dependency at all, and is ordinary C# rather than source
    embedded in XML.
  -->

  <PropertyGroup>
    <!-- NormalizePath rather than a literal separator: this build runs on Linux and macOS
         too, where a backslash written into an Exec command line is not a separator. -->
    <_DocumentationFilterTool>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'filter_public_docs.cs'))</_DocumentationFilterTool>
    <!--
      Node reuse off on both invocations below. A nested build otherwise attaches to the
      MSBuild nodes this build is already using and leaves its own environment on them; the
      inner builds that have not started yet then fail to resolve the SDK.
    -->
    <_DocumentationFilterEnvironment>MSBUILDDISABLENODEREUSE=1</_DocumentationFilterEnvironment>
  </PropertyGroup>

  <!--
    Compile the script once, before the per-framework builds start.

    Without this each of them races to compile it into the shared cache under
    %TEMP%\dotnet\runfile, and two clean builds in three fail on a locked file. Giving each
    one its own cache with an artifacts path is not the answer either: pointed inside obj it
    leaves generated assembly attributes where this project's own compile picks them up. One
    build up front removes the contention, and leaves the runs below with nothing to do but
    launch. It is a run rather than a build because there is no "dotnet build" for a script.
  -->
  <Target Name="BuildDocumentationFilter" BeforeTargets="DispatchToInnerBuilds;FilterNonPublicDocumentation"
          Condition="'$(GenerateDocumentationFile)' == 'true'">
    <Exec Command="dotnet run --file &quot;$(_DocumentationFilterTool)&quot; -- --warmup"
          EnvironmentVariables="$(_DocumentationFilterEnvironment)"
          StandardOutputImportance="low" />
  </Target>

  <!--
    Inputs/Outputs keep this to the builds that actually recompiled: the stamp ends up newer
    than the assembly, so an up-to-date build skips the target and pays nothing. Filtering in
    obj rather than bin is what makes that safe, since the copy to the output directory then
    carries the filtered file and never overwrites it with the compiler's original.
  -->
  <Target Name="FilterNonPublicDocumentation" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFramework)' != '' And '$(GenerateDocumentationFile)' == 'true' And Exists('$(DocumentationFile)')"
          Inputs="@(IntermediateAssembly)" Outputs="$(IntermediateOutputPath)documentation-filter.stamp">
    <!--
      The file switch is required: this runs with the project directory as its working
      directory, and "dotnet run path.cs" resolves the csproj sitting there rather than the
      script - which then fails, a multi-targeted project having no framework to run.
    -->
    <Exec Command="dotnet run --file &quot;$(_DocumentationFilterTool)&quot; -- &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(DocumentationFile)'))&quot;"
          EnvironmentVariables="$(_DocumentationFilterEnvironment)"
          StandardOutputImportance="normal" />
    <!--
      The stamp path is spelled out here rather than held in a property, because this file is
      imported from the project body: the SDK targets that define IntermediateOutputPath have
      not run yet, so a property computed up there resolves to the project root - one stamp
      shared by all four frameworks. The first inner build to finish then marks the target
      up-to-date for the other three, which skip it and copy out the unfiltered file. A green
      build with a wrong package, roughly one clean build in six. Target attributes and task
      parameters are evaluated when the target runs, by which point the path is correct.
    -->
    <Touch Files="$(IntermediateOutputPath)documentation-filter.stamp" AlwaysCreate="true" />
  </Target>

</Project>
