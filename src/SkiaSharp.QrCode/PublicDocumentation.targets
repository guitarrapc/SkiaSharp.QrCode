<Project>

  <!--
    Keeps the packed XML documentation to the surface a consumer can actually reach.

    The compiler documents every member carrying a doc comment, internal and private ones
    included, and this assembly comments its internals heavily: left alone a sixth of the
    entries describe something no caller can name, and the private helpers on public types
    spell internal type names into their signatures. Visibility is read out of the assembly
    that was just compiled, because a name rule cannot see either case - an internal type
    outside the Internals namespace (EciModeExtensions was one) and a private method on a
    public type both look like public API to a string match.

    ShippedDocumentationTest guards the result in both directions: that nothing unreachable
    survives, and that no public type loses its documentation.
  -->

  <ItemGroup>
    <!-- Build-time only. Reads the assembly without loading it into the build process, which
         would lock the file for the life of the MSBuild node. The netstandard2.0 flavour is
         the one an inline task can compile against. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <UsingTask TaskName="FilterNonPublicXmlDocs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DocumentationFilePath ParameterType="System.String" Required="true" />
      <AssemblyPath ParameterType="System.String" Required="true" />
      <ReferencePaths ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Reason ParameterType="System.String" Output="true" />
      <Removed ParameterType="System.Int32" Output="true" />
      <Kept ParameterType="System.Int32" Output="true" />
      <Corrupt ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(PkgSystem_Reflection_MetadataLoadContext)\lib\netstandard2.0\System.Reflection.MetadataLoadContext.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // A half-written file (an interrupted build, a full disk) would otherwise fail with a
        // raw stack trace, and because CoreCompile stays up to date the same failure would
        // repeat on every later build. The caller deletes it so the next build regenerates it.
        XDocument document = null;
        try
        {
            document = XDocument.Load(DocumentationFilePath);
        }
        catch (System.Xml.XmlException e)
        {
            Corrupt = true;
            Reason = e.Message;
            return true;
        }

        // MetadataLoadContext wants a core assembly by name and the four target frameworks do
        // not agree on which one that is, so try them against the compile-time closure in turn.
        var paths = ReferencePaths.Select(item => item.ItemSpec).Concat(new[] { AssemblyPath }).Distinct().ToArray();
        var resolver = new PathAssemblyResolver(paths);
        MetadataLoadContext context = null;
        foreach (var core in new[] { "System.Runtime", "netstandard", "mscorlib" })
        {
            try { context = new MetadataLoadContext(resolver, core); break; } catch (FileNotFoundException) { }
        }

        if (context == null)
        {
            Log.LogError("Could not read " + Path.GetFileName(AssemblyPath) + ": none of System.Runtime, netstandard or mscorlib was among the " + paths.Length + " resolved references.");
            return false;
        }

        // Keys are "T:Full.Type.Name" and "Full.Type.Name.MemberName" - deliberately not the
        // compiler's full documentation ID, which would mean re-encoding every parameter type.
        // Overloads therefore share a key, so a private overload of a public name survives.
        // That is the safe direction: this filter may keep too much, never too little.
        var visible = new HashSet<string>(StringComparer.Ordinal);
        using (context)
        {
            var assembly = context.LoadFromAssemblyPath(AssemblyPath);
            const BindingFlags declared = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;

            foreach (var type in assembly.GetTypes())
            {
                if (!IsVisibleType(type)) continue;

                var typeName = (type.FullName ?? type.Name).Replace('+', '.');
                visible.Add("T:" + typeName);
                foreach (var member in type.GetMembers(declared).Where(IsVisibleMember))
                    visible.Add(typeName + "." + (member is ConstructorInfo ? "#ctor" : member.Name));
            }
        }

        // An empty surface means the read went wrong, not that the library has no API. Saying
        // so beats silently packing a file with every entry removed.
        if (visible.Count == 0)
        {
            Log.LogError("Read no public surface out of " + Path.GetFileName(AssemblyPath) + "; refusing to empty " + Path.GetFileName(DocumentationFilePath) + ".");
            return false;
        }

        var members = document.Descendants("member").ToList();
        var unreachable = members.Where(member => !visible.Contains(KeyOf((string)member.Attribute("name")))).ToList();
        Removed = unreachable.Count;
        Kept = members.Count - Removed;

        // Only rewrite when there is something to remove, so a rebuild that changed nothing
        // leaves the file, and its timestamp, alone.
        if (Removed > 0)
        {
            foreach (var member in unreachable) member.Remove();
            document.Save(DocumentationFilePath);
        }

        // "M:Ns.Type`1.Method``1(System.Int32@)~T" -> "Ns.Type`1.Method". Type arity is a single
        // backtick and belongs to the metadata name, so only the method's double one is cut.
        string KeyOf(string id)
        {
            if (id == null || id.Length < 3 || id[1] != ':') return "";
            var body = id.Substring(2);
            var paren = body.IndexOf('(');
            if (paren >= 0) body = body.Substring(0, paren);
            if (id[0] == 'T') return "T:" + body;
            var arity = body.LastIndexOf("``", StringComparison.Ordinal);
            return arity >= 0 ? body.Substring(0, arity) : body;
        }

        // Reachable from outside the assembly. Computed rather than taken from GetExportedTypes,
        // which excludes nested protected types: a consumer reaches those by deriving.
        bool IsVisibleType(Type type)
        {
            return type.IsNested
                ? (type.IsNestedPublic || type.IsNestedFamily || type.IsNestedFamORAssem) && IsVisibleType(type.DeclaringType)
                : type.IsPublic;
        }

        // Protected and protected-internal are reachable by deriving. Internal and
        // private-protected are not: this assembly's only friend is the test project.
        // Nested types are skipped here; the type loop above covers them.
        bool IsVisibleMember(MemberInfo member)
        {
            var field = member as FieldInfo;
            if (field != null) return field.IsPublic || field.IsFamily || field.IsFamilyOrAssembly;
            var method = member as MethodBase;
            if (method != null) return method.IsPublic || method.IsFamily || method.IsFamilyOrAssembly;
            var property = member as PropertyInfo;
            if (property != null) return property.GetAccessors(true).Any(IsVisibleMember);
            var evt = member as EventInfo;
            if (evt != null) return new MethodInfo[] { evt.AddMethod, evt.RemoveMethod }.Any(m => m != null && IsVisibleMember(m));
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FilterNonPublicDocumentation" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(GenerateDocumentationFile)' == 'true' And Exists('$(DocumentationFile)')">
    <FilterNonPublicXmlDocs DocumentationFilePath="$(DocumentationFile)"
                            AssemblyPath="@(IntermediateAssembly)"
                            ReferencePaths="@(ReferencePathWithRefAssemblies)">
      <Output TaskParameter="Removed" PropertyName="_RemovedDocMembers" />
      <Output TaskParameter="Kept" PropertyName="_KeptDocMembers" />
      <Output TaskParameter="Corrupt" PropertyName="_DocumentationCorrupt" />
      <Output TaskParameter="Reason" PropertyName="_DocumentationCorruptReason" />
    </FilterNonPublicXmlDocs>

    <!-- Deleting it is what makes the failure recoverable: the next build sees the missing
         output, recompiles, and regenerates it. Erroring here stops the target before the
         copy, so the caller gets this one message instead of a follow-on MSB3030. -->
    <Delete Files="$(DocumentationFile)" Condition="'$(_DocumentationCorrupt)' == 'true'" />
    <Error Condition="'$(_DocumentationCorrupt)' == 'true'"
           Text="$(DocumentationFile) was not valid XML ($(_DocumentationCorruptReason)). It has been deleted; run the build again to regenerate it." />
    <Message Importance="normal" Text="$(MSBuildProjectName) ($(TargetFramework)): kept $(_KeptDocMembers) reachable member(s) in the XML documentation, removed $(_RemovedDocMembers) unreachable one(s)." />
  </Target>

</Project>
